{
  "name": "nailong",
  "displayName": "Nailong",
  "description": "Adds a tiny, unofficial Nailong to your status bar",
  "publisher": "Persenb",
  "version": "0.0.2",
  "license": "MIT",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Persenb/Nailong"
  },
  "homepage": "https://github.com/Persenb/Nailong#readme",
  "bugs": {
    "url": "https://github.com/Persenb/Nailong/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "nailong",
    "奶龙",
    "dragon",
    "pet",
    "buddy",
    "cute"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nailong.toggleStatusBar",
        "title": "Toggle Nailong"
      }
    ],
    "productIconThemes": [
      {
        "id": "nailong",
        "label": "Nailong Icons",
        "path": "./nailong-theme.json"
      }
    ],
    "icons": {
      "nailong-idle": {
        "description": "Nailong idle",
        "default": {
          "fontPath": "./nailong.woff",
          "fontCharacter": "\\e900"
        }
      },
      "nailong-leftdown": {
        "description": "Nailong left paw down",
        "default": {
          "fontPath": "./nailong.woff",
          "fontCharacter": "\\e901"
        }
      },
      "nailong-rightdown": {
        "description": "Nailong right paw down",
        "default": {
          "fontPath": "./nailong.woff",
          "fontCharacter": "\\e902"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.39.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.4",
    "webpack": "^5.81.0",
    "webpack-cli": "^5.0.2"
  }
}
